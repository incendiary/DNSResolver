[flake8]
max-line-length = 88
extend-ignore =
    # E203: whitespace before ':' — conflicts with Black slice formatting
    E203,
    # W503: line break before binary operator — conflicts with Black
    W503,
    # E501: line too long — Black handles line length for code; strings/docstrings
    # that exceed 88 chars are left untouched by Black by design
    E501
exclude =
    .venv,
    __pycache__,
    .git
