{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/dnsresolver/contracts/dns-observations-v1.schema.json",
  "title": "DNSResolver non-actionable observations v1",
  "description": "Complete DNS observations retained outside the allocator target feed.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "contract_version",
      "hostname",
      "kind",
      "ips",
      "reasons",
      "actionability"
    ],
    "properties": {
      "contract_version": {"const": "1.0"},
      "hostname": {"type": "string", "minLength": 1},
      "kind": {
        "enum": [
          "wildcard",
          "wildcard_zone",
          "dangling_cname",
          "ns_takeover",
          "unresolved",
          "provider_catalog_incomplete"
        ]
      },
      "ips": {
        "type": "array",
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 2}
      },
      "reasons": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      },
      "actionability": {"const": "excluded"}
    }
  }
}
