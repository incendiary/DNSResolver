{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/dnsresolver/contracts/allocator-targets-v1.schema.json",
  "title": "DNSResolver actionable allocator targets v1",
  "description": "Only DNS observations that are safe to hand to a provider-aware allocator.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "contract_version",
      "hostname",
      "ip",
      "provider",
      "region",
      "services",
      "prefixes",
      "network_border_groups",
      "dns_record_type",
      "actionability"
    ],
    "properties": {
      "contract_version": {"const": "1.0"},
      "hostname": {"type": "string", "minLength": 1},
      "ip": {"type": "string", "minLength": 2},
      "provider": {"enum": ["aws", "gcp", "azure"]},
      "region": {
        "type": "string",
        "minLength": 1,
        "description": "Provider-published AWS region, GCP scope, or Azure region; never inferred."
      },
      "services": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      },
      "prefixes": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      },
      "network_border_groups": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      },
      "dns_record_type": {"enum": ["A", "AAAA"]},
      "actionability": {"const": "actionable"}
    }
  }
}
